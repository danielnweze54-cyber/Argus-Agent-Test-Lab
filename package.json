{
  "name": "argus-agent-test-lab",
  "version": "0.1.0",
  "description": "Argus Agent Test Lab - Universal AgentTargetAdapter",
  "type": "module",
  "bin": {
    "argus-cli": "./dist/cli/argus.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "cli": "ts-node --esm src/cli/argus.ts",
    "argus": "tsx src/cli/argus.ts",
    "smoke:local": "node scripts/local-smoke.mjs",
    "sut-server": "tsx tools/sut-server/server.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "tsx": "^4.23.13",
    "viem": "^2.56.5"
  }
}
