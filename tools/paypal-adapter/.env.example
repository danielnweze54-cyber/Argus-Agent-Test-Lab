# Block D / PayPal adapter configuration (draft scaffold)
# Copy to .env and fill. Never commit real values.

# --- SUT: agentmiddleware/amw-paypal-agent-demo (mini_gateway HTTP surface) ---
AMW_GATEWAY_BASE_URL=http://localhost:8080
AMW_ADMIN_API_KEY=
# gateway.py prints a fresh admin key per run; wallet routes live under this base URL

# --- PayPal sandbox (SUT-side upstream; credentials belong to the SUT owner) ---
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Fault injection proxy placed between SUT and rail ---
FAULT_PROXY_LISTEN_HOST=127.0.0.1
FAULT_PROXY_LISTEN_PORT=8888
FAULT_PROXY_UPSTREAM_URL=https://api-m.sandbox.paypal.com
# Comma-separated active faults for S10:
FAULT_PROXY_SCENARIOS=lost_response_after_capture
# Optional extra edges (kept disabled for canonical S10):
FAULT_PROXY_EXTRA=timeout,duplicate_response

# --- Offline dev loop (no PayPal keys required) ---
USE_MOCK_PAYPAL=true
